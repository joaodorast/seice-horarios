# Token de acesso da conta Supabase (https://supabase.com/dashboard/account/tokens).
# Usado apenas por `npm run db:setup` para preparar o banco.
SUPABASE_ACCESS_TOKEN=

# Projeto Supabase onde o SEICE será instalado (Project Settings > General > Reference ID).
# O SEICE usa somente o schema "seice", então o projeto pode ser compartilhado com outro sistema.
# Deixe em branco para criar um projeto novo chamado "seice-horarios".
SUPABASE_PROJECT_REF=

# URL de conexão PostgreSQL (pooler em modo transação, porta 6543). Preenchida por `npm run db:setup`.
DATABASE_URL=

# Porta do servidor do SEICE (opcional).
PORT=3333
